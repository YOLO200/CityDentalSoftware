# Copy to .env.local and fill in. Never commit .env.local.

VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon key from Supabase → Project Settings → API>

# Optional. Error reporting is off when this is empty.
# Sentry → Settings → Projects → <project> → Client Keys (DSN)
VITE_SENTRY_DSN=
